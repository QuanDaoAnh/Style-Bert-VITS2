name: "pipeline"
platform: "ensemble"
max_batch_size: 0

input [
    {
    name: "VERSION"
    data_type: TYPE_INT64
    dims: [ 1, -1 ]
  },
  {
    name: "TEXT"
    data_type: TYPE_INT64
    dims: [ 1, -1 ]
  },
  {
    name: "ASSIST_TEXT"
    data_type: TYPE_INT64
    dims: [ 1, -1 ]
    optional: true
  },
  {
    name: "ASSIST_TEXT_WEIGHT"
    data_type: TYPE_FP32
    dims: [ 1]
  },
  {
    name: "GIVEN_PHONE"
    data_type: TYPE_INT64
    dims: [ -1, -1 ]
    optional: true
  },
  {
    name: "GIVEN_TONE"
    data_type: TYPE_INT64
    dims: [ -1 ]
    optional: true
  },
  {
    name: "ADD_BLANK"
    data_type: TYPE_INT64
    dims: [ 1 ]
  },
  {
    name: "SKIP_START"
    data_type: TYPE_INT64
    dims: [ 1 ]
  },
  {
    name: "SKIP_END"
    data_type: TYPE_INT64
    dims: [ 1 ]
  },
  {
    name: "SID"
    data_type: TYPE_INT64
    dims: [ 1 ]
  },
  {
    name: "STYLE_VEC"
    data_type: TYPE_FP32
    dims: [ 1, 256 ]
    optional: true
  },
  {
    name: "STYLE"
    data_type: TYPE_INT64
    dims: [ 1, -1 ]
    optional: true
  },
  {
    name: "STYLE_WEIGHT"
    data_type: TYPE_FP32
    dims: [ 1 ]
    optional: true
  },
  {
    name: "STYLES"
    data_type: TYPE_INT64
    dims: [ -1, -1 ]
    optional: true
  },
  {
    name: "STYLE_WEIGHTS"
    data_type: TYPE_FP32
    dims: [ -1 ]
    optional: true
  },
  {
    name: "NOISE_SCALE"
    data_type: TYPE_FP32
    dims: [ 1 ]
  },
  {
    name: "LENGTH_SCALE"
    data_type: TYPE_FP32
    dims: [ 1 ]
  },
  {
    name: "NOISE_SCALE_W"
    data_type: TYPE_FP32
    dims: [ 1 ]
  },
  {
    name: "MAX_LEN"
    data_type: TYPE_INT64
    dims: [ 1 ]
    optional: true
  },
  {
    name: "SDP_RATIO"
    data_type: TYPE_FP32
    dims: [ 1 ]
  },
  {
    name: "Y"
    data_type: TYPE_INT64
    dims: [ -1 ]
    optional: true
  }
]

output [
  {
    name: "AUDIO"
    data_type: TYPE_FP32
    dims: [ -1, -1 ]
  }
]

ensemble_scheduling {
  step [
    {
        model_name: "bert_jp"
        model_version: -1

        input_map {
            key: "VERSION"
            value: "VERSION"
        }
        input_map {
            key: "TEXT"
            value: "TEXT"
        }
        input_map {
            key: "ASSIST_TEXT"
            value: "ASSIST_TEXT"
        }
        input_map {
            key: "ASSIST_TEXT_WEIGHT"
            value: "ASSIST_TEXT_WEIGHT"
        }
        input_map {
            key: "GIVEN_PHONE"
            value: "GIVEN_PHONE"
        }
        input_map {
            key: "GIVEN_TONE"
            value: "GIVEN_TONE"
        }
        input_map {
            key: "ADD_BLANK"
            value: "ADD_BLANK"
        }
        input_map {
            key: "SKIP_START"
            value: "SKIP_START"
        }
        input_map {
            key: "SKIP_END"
            value: "SKIP_END"
        }

        output_map {
            key: "BERT"
            value: "BERT"
        }
        output_map {
            key: "JA_BERT"
            value: "JA_BERT"
        }
        output_map {
            key: "EN_BERT"
            value: "EN_BERT"
        }
        output_map {
            key: "PHONES"
            value: "PHONES"
        }
        output_map {
            key: "TONE"
            value: "TONE"
        }
        output_map {
            key: "LANG_IDS"
            value: "LANG_IDS"
        }
    },
    {
        model_name: "tts_jp"
        model_version: -1

        input_map {
            key: "X"
            value: "PHONES"
        }
        input_map {
            key: "SID"
            value: "SID"
        }
        input_map {
            key: "TONE"
            value: "TONE"
        }
        input_map {
            key: "LANGUAGE"
            value: "LANG_IDS"
        }
        input_map {
            key: "BERT"
            value: "BERT"
        }
        input_map {
            key: "JA_BERT"
            value: "JA_BERT"
        }
        input_map {
            key: "EN_BERT"
            value: "EN_BERT"
        }
        input_map {
            key: "STYLE_VEC"
            value: "STYLE_VEC"
        }
        input_map {
            key: "STYLE"
            value: "STYLE"
        }
        input_map {
            key: "STYLE_WEIGHT"
            value: "STYLE_WEIGHT"
        }
        input_map {
            key: "STYLES"
            value: "STYLES"
        }
        input_map {
            key: "STYLE_WEIGHTS"
            value: "STYLE_WEIGHTS"
        }
        input_map {
            key: "NOISE_SCALE"
            value: "NOISE_SCALE"
        }
        input_map {
            key: "LENGTH_SCALE"
            value: "LENGTH_SCALE"
        }
        input_map {
            key: "NOISE_SCALE_W"
            value: "NOISE_SCALE_W"
        }
        input_map {
            key: "MAX_LEN"
            value: "MAX_LEN"
        }
        input_map {
            key: "SDP_RATIO"
            value: "SDP_RATIO"
        }
        input_map {
            key: "Y"
            value: "Y"
        }
        input_map {
            key: "VERSION"
            value: "VERSION"
        }


        output_map {
            key: "AUDIO"
            value: "AUDIO"
        }
    }
  ]
}