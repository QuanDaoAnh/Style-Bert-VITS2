name: "bert_jp"
backend: "python"
max_batch_size: 0

input [
  {
    name: "VERSION"
    data_type: TYPE_INT64
    dims: [ 1, -1 ]
  },
  {
    name: "TEXT"
    data_type: TYPE_INT64
    dims: [ 1, -1 ]
  },
  {
    name: "ASSIST_TEXT"
    data_type: TYPE_INT64
    dims: [ 1, -1 ]
    optional: true
  },
  {
    name: "ASSIST_TEXT_WEIGHT"
    data_type: TYPE_FP32
    dims: [ 1]
  },
  {
    name: "GIVEN_PHONE"
    data_type: TYPE_INT64
    dims: [ -1, -1 ]
    optional: true
  },
  {
    name: "GIVEN_TONE"
    data_type: TYPE_INT64
    dims: [ -1 ]
    optional: true
  },
  {
    name: "ADD_BLANK"
    data_type: TYPE_INT64
    dims: [ 1 ]
  },
  {
    name: "SKIP_START"
    data_type: TYPE_INT64
    dims: [ 1 ]
  },
  {
    name: "SKIP_END"
    data_type: TYPE_INT64
    dims: [ 1 ]
  }
]

output [
  {
    name: "BERT"
    data_type: TYPE_FP32
    dims: [ 1, 1024, -1 ]
  },
  {
    name: "JA_BERT"
    data_type: TYPE_FP32
    dims: [ 1, 1024, -1 ]
  },
  {
    name: "EN_BERT"
    data_type: TYPE_FP32
    dims: [ 1, 1024, -1 ]
  },
  {
    name: "PHONES"
    data_type: TYPE_INT64
    dims: [ 1, -1 ]
  },
  {
    name: "TONE"
    data_type: TYPE_INT64
    dims: [ 1, -1 ]
  },
  {
    name: "LANG_IDS"
    data_type: TYPE_INT64
    dims: [ 1, -1 ]
  }
]

parameters: {
  key: "model_file",
  value: {string_value: "ku-nlp/deberta-v2-large-japanese-char-wwm"}
}